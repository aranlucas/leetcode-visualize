{
  "manifest_version": 3,
  "name": "ProblemPrism — Coding interview tutor",
  "description": "Learn how to reason through LeetCode and NeetCode problems with interview coaching, opt-in code review, hints, and interactive visualizations.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Open ProblemPrism",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://*.leetcode.com/problems/*",
        "https://neetcode.io/problems/*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://auth.openai.com/*",
    "https://chatgpt.com/*",
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://neetcode.io/*"
  ],
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
